{
  "name": "oscd-explorer",
  "version": "0.0.1",
  "description": "Omicron Academy distribution - To support IEC 61850 training.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-explorer.git"
  },
  "keywords": [
    "scl",
    "xml",
    "iec",
    "61850",
    "iec61850",
    "scd",
    "omicronenergy"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-explorer/issues"
  },
  "homepage": "https://OMICRONEnergyOSS.github.io/oscd-explorer/index.html",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "bundle": "rimraf dist && rollup -c rollup.config.js",
    "deploy": "npm run bundle && gh-pages -d dist --nojekyll",
    "start": "web-dev-server --node-resolve --open",
    "start:bundle": "concurrently -k -r \"rollup -c rollup.config.js -w\" \"web-dev-server --root-dir dist --app-index index.html --open\""
  },
  "dependencies": {
    "@compas-bearingpoint/plugins": "file:../../stee-re/compas-bearingpoint-plugins",
    "@omicronenergy/oscd-background-editv1": "^0.0.7",
    "@omicronenergy/oscd-background-plugin-config": "file:../oscd-background-plugin-config",
    "@omicronenergy/oscd-background-wizard-events": "^0.0.4",
    "@omicronenergy/oscd-menu-commons": "^0.0.1",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-shell": "file:../../stee-re/oscd-shell",
    "@open-wc/scoped-elements": "^3.0.6",
    "@openenergytools/xml-schema-validator": "^0.0.1",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "ace-builds": "^1.44.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "~9.34.0",
    "@open-wc/eslint-config": "^13.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^9.2.1",
    "eslint": "~9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-wc": "^3.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.9.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@web/dev-server": "^1.0.0",
    "@web/rollup-plugin-html": "^4.0.0",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0"
  }
}
